<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:layout_marginTop="30dp">

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Make reservation now"
            android:textColor="#001F3F"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxBackgroundColor="@android:color/white"
            android:alpha="0.85"
            android:hint="First Name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/firstName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxBackgroundColor="@android:color/white"
            android:alpha="0.85"
            android:hint="Last Name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/lastName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxBackgroundColor="@android:color/white"
            android:alpha="0.85"
            android:hint="Age">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/age"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/checkInText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check-in: Not selected"
            android:layout_marginTop="20dp"
            android:textColor="#001F3F" />

        <Button
            android:id="@+id/pickCheckIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Select Check-In Date"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="@android:color/black"
            android:alpha="0.85"
            android:minHeight="50dp"/>

        <TextView
            android:id="@+id/checkOutText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check-out: Not selected"
            android:layout_marginTop="20dp"
            android:textColor="#001F3F" />

        <Button
            android:id="@+id/pickCheckOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Select Check-Out Date"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="@android:color/black"
            android:alpha="0.85"
            android:minHeight="50dp"/>

        <TextView
            android:id="@+id/tvRoomStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Room Style"
            android:textColor="#001F3F"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:id="@+id/layoutDeluxe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_margin="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/room_selector_bg"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/imgDeluxe"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/room1"
                    android:layout_marginBottom="10dp"
                    android:scaleType="centerCrop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deluxe\nRs.6000/night"
                    android:textAlignment="center"
                    android:textColor="#000000" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutPremium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_margin="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/room_selector_bg"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/imgPremium"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/room2"
                    android:layout_marginBottom="10dp"
                    android:scaleType="centerCrop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Premium\nRs.10500/night"
                    android:textAlignment="center"
                    android:textColor="#000000" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutExecutive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_margin="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/room_selector_bg"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/imgExecutive"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/room3"
                    android:layout_marginBottom="10dp"
                    android:scaleType="centerCrop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Executive\nRs.15000/night"
                    android:textAlignment="center"
                    android:textColor="#000000" />
            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/selectedRoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/submitBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Submit"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="@android:color/black"
            android:layout_marginBottom="50dp"
            android:alpha="0.85"
            android:minHeight="50dp"/>

    </LinearLayout>
</ScrollView>